local function getCachedName(obj)
	local cached = NameCache[obj]
	if cached then return cached end
	local name = obj:IsA("Player") and obj.DisplayName or obj.Name
	NameCache[obj] = name
	return name
end
local function getHealthSource(model)
	local cached = Cache.HealthSources[model]
	if cached then
		local valid = true
		if cached.type == "Humanoid" and not cached.instance.Parent then
			valid = false
		elseif cached.type == "Value" then
			if (cached.health and not cached.health.Parent) or (cached.maxHealth and not cached.maxHealth.Parent) then
				valid = false
			end
		elseif cached.type == "Attribute" and not cached.model.Parent then
			valid = false
		end
		
		if not valid then
			Cache.HealthSources[model] = nil
		else
			return cached
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		cached = { type = "Humanoid", instance = humanoid }
		Cache.HealthSources[model] = cached
		return cached
	end
	local hAttr = model:GetAttribute("Health")
	local mAttr = model:GetAttribute("MaxHealth")
	if hAttr ~= nil or mAttr ~= nil then
		cached = { type = "Attribute", model = model }
		Cache.HealthSources[model] = cached
		return cached
	end
	local hVal = model:FindFirstChild("Health")
	local mVal = model:FindFirstChild("MaxHealth")
	if hVal and (hVal:IsA("NumberValue") or hVal:IsA("IntValue")) then
		cached = { type = "Value", health = hVal, maxHealth = mVal }
		Cache.HealthSources[model] = cached
		return cached
	end
	local folder = model:FindFirstChild("Health") or model:FindFirstChild("Stats") or model:FindFirstChild("Data")
	if folder then
		local fh = folder:FindFirstChild("Health")
		local fm = folder:FindFirstChild("MaxHealth")
		if fh and (fh:IsA("NumberValue") or fh:IsA("IntValue")) then
			cached = { type = "Value", health = fh, maxHealth = fm }
			Cache.HealthSources[model] = cached
			return cached
		end
	end
	return nil
end
local function hasHealthSystem(obj)
	if Cache.HasHealthSystem[obj] ~= nil then
		return Cache.HasHealthSystem[obj]
	end
	local hasHealth = getHealthSource(obj) ~= nil
	Cache.HasHealthSystem[obj] = hasHealth
	return hasHealth
end
local function isPlayerCharacter(model)
	if Cache.IsPlayerCharacter[model] ~= nil then
		return Cache.IsPlayerCharacter[model]
	end
	local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
	Cache.IsPlayerCharacter[model] = isPlayer
	return isPlayer
end
local function getNPCRoot(model)
	local cached = Cache.RootParts[model]
	if cached and cached.Parent then
		return cached
	end
	local root = model:FindFirstChild("HumanoidRootPart")
		or model.PrimaryPart
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChildWhichIsA("BasePart")
	Cache.RootParts[model] = root
	return root
end
local function getNPCHealth(model)
	local source = getHealthSource(model)
	if not source then return 100, 100, nil end
	if source.type == "Humanoid" then
		return source.instance.Health, source.instance.MaxHealth, source.instance
	elseif source.type == "Attribute" then
		return source.model:GetAttribute("Health") or 100, source.model:GetAttribute("MaxHealth") or 100, nil
	elseif source.type == "Value" then
		local h = source.health and source.health.Value or 100
		local m = source.maxHealth and source.maxHealth.Value or 100
		return h, m, nil
	end
	return 100, 100, nil
end
local function connectHealthChanged(model, callback)
	local source = getHealthSource(model)
	if not source then return nil end
	if source.type == "Humanoid" then
		return source.instance:GetPropertyChangedSignal("Health"):Connect(function()
			callback(source.instance.Health, source.instance.MaxHealth)
		end)
	elseif source.type == "Attribute" then
		local conn1 = source.model:GetAttributeChangedSignal("Health"):Connect(function()
			callback(source.model:GetAttribute("Health") or 100, source.model:GetAttribute("MaxHealth") or 100)
		end)
		local conn2 = source.model:GetAttributeChangedSignal("MaxHealth"):Connect(function()
			callback(source.model:GetAttribute("Health") or 100, source.model:GetAttribute("MaxHealth") or 100)
		end)
		return {
			Disconnect = function()
				conn1:Disconnect()
				conn2:Disconnect()
			end,
			Connected = true
		}
	elseif source.type == "Value" then
		local conns = {}
		if source.health then
			table.insert(conns, source.health.Changed:Connect(function()
				callback(source.health.Value or 100, source.maxHealth and source.maxHealth.Value or 100)
			end))
		end
		if source.maxHealth then
			table.insert(conns, source.maxHealth.Changed:Connect(function()
				callback(source.health and source.health.Value or 100, source.maxHealth.Value or 100)
			end))
		end
		return {
			Disconnect = function()
				for _, c in ipairs(conns) do c:Disconnect() end
			end,
			Connected = true
		}
	end
	return nil
end
