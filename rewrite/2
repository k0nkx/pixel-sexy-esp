local function CreatePlayerData(player)
	if PlayerData[player] then return end
	updateFriendCache(player)
	local data = {
		Player = player,
		Items = {},
		Info = {},
		HealthTween = nil,
		LastHealth = nil,
		DamageIndicators = {},
		DamageOrder = 0,
		Connections = {},
		IsDead = false,
		DeathStarted = false,
		FrozenTop = nil,
		FrozenBottom = nil,
		FrozenRootPos = nil,
	}
	local items = data.Items
	local holder = Instance.new("Frame")
	holder.Name = getCachedName(player)
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Visible = false
	holder.ZIndex = 1
	holder.Parent = ScreenGui
	items.Holder = holder
	local highlight = Instance.new("Highlight")
	highlight.Name = "PlayerHighlight"
	highlight.FillColor = Settings.Highlight.FillColor
	highlight.FillTransparency = Settings.Highlight.FillTransparency
	highlight.OutlineColor = Settings.Highlight.OutlineColor
	highlight.OutlineTransparency = Settings.Highlight.OutlineTransparency
	highlight.DepthMode = Settings.Highlight.DepthMode
	highlight.Parent = ScreenGui
	items.Highlight = highlight
	local sideItems = CreateSideFrames(holder)
	for k, v in pairs(sideItems) do items[k] = v end
	if Settings.Healthbar.Enabled then CreateHealthbar(items) end
	if Settings.HealthText.Enabled then CreateHealthText(items) end
	if Settings.Name.Enabled then CreateNameTag(items) end
	if Settings.Tool.Enabled then CreateToolTag(items) end
	if Settings.Distance.Enabled then CreateDistanceTag(items) end
	data.ResetVisuals = function()
		for _, entry in ipairs(data.DamageIndicators) do
			if entry.Instance then entry.Instance:Destroy() end
		end
		table.clear(data.DamageIndicators)
		if items.Healthbar then items.Healthbar.BackgroundTransparency = 0 end
		if items.HealthbarAccent then items.HealthbarAccent.BackgroundTransparency = 0 end
		if items.HealthbarFade then items.HealthbarFade.BackgroundTransparency = 0 end
		if items.HealthText then items.HealthText.TextTransparency = 0 end
		-- Restore ALL UIStroke transparencies (this was the missing piece)
		if items.Holder then
			for _, obj in ipairs(items.Holder:GetDescendants()) do
				if obj:IsA("UIStroke") then
					obj.Transparency = 0
				end
			end
		end
		if items.NameTag then items.NameTag.TextTransparency = 0 end
		if items.ToolTag then items.ToolTag.TextTransparency = 0 end
		if items.DistanceTag then items.DistanceTag.TextTransparency = 0 end
		data.IsDead = false
		data.DeathStarted = false
		data.FrozenTop = nil
		data.FrozenBottom = nil
		data.FrozenRootPos = nil
	end
	data.AddHealthChange = function(delta)
		if data.IsDead or not Settings.HealthChange.Enabled or not items.DamageStack then return end
		if math.abs(delta) < 0.5 then return end
		while #data.DamageIndicators >= Settings.HealthChange.MaxVisible do
			local oldest = table.remove(data.DamageIndicators, 1)
			if oldest and oldest.Instance then oldest.Instance:Destroy() end
		end
		data.DamageOrder = data.DamageOrder - 1
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 0, 9)
		label.Text = (delta > 0 and "+" or "") .. tostring(math.floor(delta + 0.5))
		label.TextSize = Settings.HealthChange.TextSize
		label.TextColor3 = delta > 0 and Settings.HealthChange.HealColor or Settings.HealthChange.DamageColor
		label.TextXAlignment = Enum.TextXAlignment.Right
		label.TextYAlignment = Enum.TextYAlignment.Top
		label.TextTransparency = 0
		label.ZIndex = 7
		label.LayoutOrder = data.DamageOrder
		label.Parent = items.DamageStack
		ApplyFont(label)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 1
		stroke.Color = Color3.fromRGB(0, 0, 0)
		stroke.LineJoinMode = Enum.LineJoinMode.Miter
		stroke.Transparency = 0
		stroke.Parent = label
		table.insert(data.DamageIndicators, {Instance = label, Stroke = stroke})
		task.delay(Settings.HealthChange.HoldTime, function()
			if not label or not label.Parent then return end
			local fadeInfo = TweenInfo.new(Settings.HealthChange.FadeTime, Enum.EasingStyle.Linear)
			local t1 = TweenService:Create(label, fadeInfo, {TextTransparency = 1})
			local t2 = TweenService:Create(stroke, fadeInfo, {Transparency = 1})
			t1:Play()
			t2:Play()
			t1.Completed:Connect(function()
				if label and label.Parent then label:Destroy() end
				for i, v in ipairs(data.DamageIndicators) do
					if v.Instance == label then
						table.remove(data.DamageIndicators, i)
						break
					end
				end
			end)
		end)
	end
	data.StartDeathEffect = function()
		if data.DeathStarted then return end
		data.DeathStarted = true
		data.IsDead = true
		if not Settings.Death.Enabled then
			if items.Holder then items.Holder.Visible = false end
			return
		end
		if data.Info.RootPart then
			local root = data.Info.RootPart
			data.FrozenRootPos = root.Position
			data.FrozenTop = root.Position + (root.CFrame.UpVector * 1.8)
			data.FrozenBottom = root.Position - (root.CFrame.UpVector * 2.5)
		end
		task.delay(Settings.Death.HoldTime, function()
			if not items.Holder or not items.Holder.Parent then return end
			local fadeInfo = TweenInfo.new(Settings.Death.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			for _, obj in ipairs(items.Holder:GetDescendants()) do
				if obj:IsA("Frame") then
					TweenService:Create(obj, fadeInfo, {BackgroundTransparency = 1}):Play()
				elseif obj:IsA("TextLabel") then
					TweenService:Create(obj, fadeInfo, {TextTransparency = 1}):Play()
					local s = obj:FindFirstChildOfClass("UIStroke")
					if s then TweenService:Create(s, fadeInfo, {Transparency = 1}):Play() end
				elseif obj:IsA("UIStroke") then
					TweenService:Create(obj, fadeInfo, {Transparency = 1}):Play()
				end
			end
			task.delay(Settings.Death.FadeTime + 0.05, function()
				if items.Holder then items.Holder.Visible = false end
				for _, entry in ipairs(data.DamageIndicators) do
					if entry.Instance then entry.Instance:Destroy() end
				end
				table.clear(data.DamageIndicators)
			end)
		end)
	end
	data.UpdateHealth = function(health, maxHealth)
		if data.IsDead or not Settings.Healthbar.Enabled or not items.HealthbarFade then return end
		maxHealth = maxHealth or 100
		local ratio = math.clamp(health / maxHealth, 0, 1)
		local isHorizontal = Settings.Healthbar.Position == "Top" or Settings.Healthbar.Position == "Bottom"
		local targetSize, targetPos
		if isHorizontal then
			targetSize = UDim2.new(1 - ratio, -2 * (1 - ratio), 1, -2)
			targetPos = UDim2.new(ratio, 1, 0, 1)
		else
			targetSize = UDim2.new(1, -2, 1 - ratio, -2 * (1 - ratio))
			targetPos = UDim2.new(0, 1, 0, 1)
		end
		if Settings.Healthbar.Tween then
			if data.HealthTween then data.HealthTween:Cancel() end
			local info = TweenInfo.new(Settings.Healthbar.TweenSpeed, Settings.Healthbar.EasingStyle, Settings.Healthbar.EasingDirection)
			data.HealthTween = TweenService:Create(items.HealthbarFade, info, {Size = targetSize, Position = targetPos})
			data.HealthTween:Play()
		else
			items.HealthbarFade.Size = targetSize
			items.HealthbarFade.Position = targetPos
		end
		if items.HealthText then
			items.HealthText.Text = tostring(math.floor(health + 0.5))
		end
		if data.LastHealth ~= nil then
			local delta = health - data.LastHealth
			if math.abs(delta) >= 1 then data.AddHealthChange(delta) end
		end
		data.LastHealth = health
		if health <= 0 then data.StartDeathEffect() end
	end
	data.UpdateExtras = function(distance)
		if data.IsDead then return end
		if items.NameTag and Settings.Name.Enabled then
			local isFriend = Settings.FriendName.Enabled and FriendCache[player.UserId]
			if isFriend then
				items.NameTag.Text = Settings.FriendName.Text
				items.NameTag.TextColor3 = Settings.FriendName.Color
			else
				items.NameTag.TextColor3 = Settings.Name.Color
				local mode = string.lower(tostring(Settings.Name.Mode or "both"))
				local displayName = getCachedName(player)
				local userName = player.Name
				
				if mode:find("display") or mode == "d" then
					items.NameTag.Text = displayName
				elseif mode:find("user") or mode == "u" then
					items.NameTag.Text = userName
				else
					-- Both (default)
					if displayName ~= userName then
						items.NameTag.Text = displayName .. " (@" .. userName .. ")"
					else
						items.NameTag.Text = userName
					end
				end
			end
		end
		if items.ToolTag and Settings.Tool.Enabled then
			local toolName = ""
			if data.Info.Character then
				local tool = data.Info.Character:FindFirstChildOfClass("Tool")
				if tool then toolName = tool.Name end
			end
			items.ToolTag.Text = toolName
			items.ToolTag.Visible = toolName ~= ""
		end
		if items.DistanceTag and Settings.Distance.Enabled and distance then
			items.DistanceTag.Text = math.floor(distance + 0.5) .. Settings.Distance.Suffix
		end
	end
	data.RefreshCharacter = function()
		local character = player.Character
		if not character then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			humanoid = character:WaitForChild("Humanoid", 5)
			if not humanoid then return end
		end
		data.ResetVisuals()
		data.Info.Character = character
		data.Info.Humanoid = humanoid
		data.Info.RootPart = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 3)
		if Settings.Highlight.Enabled then
			data.Items.Highlight.Adornee = character
		else
			data.Items.Highlight.Adornee = nil
		end
		if data.HealthConn then 
			if typeof(data.HealthConn) == "RBXScriptConnection" then data.HealthConn:Disconnect() 
			elseif type(data.HealthConn) == "table" and data.HealthConn.Disconnect then data.HealthConn:Disconnect() end
			data.HealthConn = nil 
		end
		data.LastHealth = humanoid.Health
		data.HealthConn = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
			data.UpdateHealth(humanoid.Health, humanoid.MaxHealth)
		end)
		local diedConn = humanoid.Died:Connect(function()
			data.StartDeathEffect()
		end)
		table.insert(data.Connections, diedConn)
		data.UpdateHealth(humanoid.Health, humanoid.MaxHealth)
	end
	data.Destroy = function()
		for _, conn in ipairs(data.Connections) do
			if typeof(conn) == "RBXScriptConnection" and conn.Connected then conn:Disconnect() 
			elseif type(conn) == "table" and conn.Disconnect then conn:Disconnect() end
		end
		table.clear(data.Connections)
		if data.HealthConn then 
			if typeof(data.HealthConn) == "RBXScriptConnection" then data.HealthConn:Disconnect() 
			elseif type(data.HealthConn) == "table" and data.HealthConn.Disconnect then data.HealthConn:Disconnect() end
			data.HealthConn = nil 
		end
		if data.HealthTween then data.HealthTween:Cancel() data.HealthTween = nil end
		for _, entry in ipairs(data.DamageIndicators) do
			if entry.Instance then entry.Instance:Destroy() end
		end
		table.clear(data.DamageIndicators)
		if items.Highlight then items.Highlight:Destroy() end
		if items.Holder then items.Holder:Destroy() end
		PlayerData[player] = nil
	end
	local charConn = player.CharacterAdded:Connect(function()
		task.defer(function() data.RefreshCharacter() end)
	end)
	table.insert(data.Connections, charConn)
	if player.Character then
		task.defer(function() data.RefreshCharacter() end)
	end
	PlayerData[player] = data
end
-- ========== NPC DATA ==========
local function CreateNPCData(model)
	if NPCData[model] or not Settings.NPC.Enabled then return end
	if not hasHealthSystem(model) then return end
	if isPlayerCharacter(model) then return end
	local root = getNPCRoot(model)
	if not root then return end
	local data = {
		Model = model,
		Items = {},
		Info = {},
		HealthTween = nil,
		LastHealth = nil,
		IsDead = false,
		DeathStarted = false,
		FrozenTop = nil,
		FrozenBottom = nil,
		FrozenRootPos = nil,
		Connections = {},
	}
	local items = data.Items
	local holder = Instance.new("Frame")
	holder.Name = "NPC_" .. getCachedName(model)
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Visible = false
	holder.ZIndex = 1
	holder.Parent = ScreenGui
	items.Holder = holder
	local highlight = Instance.new("Highlight")
	highlight.Name = "NPCHighlight"
	highlight.FillColor = Settings.Highlight.FillColor
	highlight.FillTransparency = Settings.Highlight.FillTransparency
	highlight.OutlineColor = Settings.Highlight.OutlineColor
	highlight.OutlineTransparency = Settings.Highlight.OutlineTransparency
	highlight.DepthMode = Settings.Highlight.DepthMode
	highlight.Parent = ScreenGui
	items.Highlight = highlight
	local sideItems = CreateSideFrames(holder)
	for k, v in pairs(sideItems) do items[k] = v end
	if Settings.NPC.ShowHealthbar and Settings.Healthbar.Enabled then
		CreateHealthbar(items)
	end
	if Settings.NPC.ShowHealthText and Settings.HealthText.Enabled then
		CreateHealthText(items)
	end
	if Settings.NPC.ShowName then
		local label = CreateOutlinedText(items.Top, "NameTag", Settings.NPC.NameSize, Settings.NPC.NameColor, true)
		label.LayoutOrder = 0
		items.NameTag = label
	end
	if Settings.NPC.ShowDistance and Settings.Distance.Enabled then
		CreateDistanceTag(items)
	end
	data.UpdateHealth = function(health, maxHealth)
		if data.IsDead or not items.HealthbarFade then return end
		maxHealth = maxHealth or 100
		local ratio = math.clamp(health / maxHealth, 0, 1)
		local targetSize = UDim2.new(1, -2, 1 - ratio, -2 * (1 - ratio))
		local targetPos = UDim2.new(0, 1, 0, 1)
		if Settings.Healthbar.Tween then
			if data.HealthTween then data.HealthTween:Cancel() end
			local info = TweenInfo.new(Settings.Healthbar.TweenSpeed, Settings.Healthbar.EasingStyle, Settings.Healthbar.EasingDirection)
			data.HealthTween = TweenService:Create(items.HealthbarFade, info, {Size = targetSize, Position = targetPos})
			data.HealthTween:Play()
		else
			items.HealthbarFade.Size = targetSize
			items.HealthbarFade.Position = targetPos
		end
		if items.HealthText then
			items.HealthText.Text = tostring(math.floor(health + 0.5))
		end
		data.LastHealth = health
	end
	data.StartDeathEffect = function()
		if data.DeathStarted then return end
		data.DeathStarted = true
		data.IsDead = true
		if not Settings.Death.Enabled then
			if items.Holder then items.Holder.Visible = false end
			return
		end
		if data.Info.RootPart then
			local root = data.Info.RootPart
			data.FrozenRootPos = root.Position
			data.FrozenTop = root.Position + (root.CFrame.UpVector * 1.8)
			data.FrozenBottom = root.Position - (root.CFrame.UpVector * 2.5)
		end
		task.delay(Settings.Death.HoldTime, function()
			if not items.Holder or not items.Holder.Parent then return end
			local fadeInfo = TweenInfo.new(Settings.Death.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			for _, obj in ipairs(items.Holder:GetDescendants()) do
				if obj:IsA("Frame") then
					TweenService:Create(obj, fadeInfo, {BackgroundTransparency = 1}):Play()
				elseif obj:IsA("TextLabel") then
					TweenService:Create(obj, fadeInfo, {TextTransparency = 1}):Play()
					local s = obj:FindFirstChildOfClass("UIStroke")
					if s then TweenService:Create(s, fadeInfo, {Transparency = 1}):Play() end
				end
			end
			task.delay(Settings.Death.FadeTime + 0.05, function()
				if data.Destroy then data.Destroy() end
			end)
		end)
	end
	data.Refresh = function()
		if not model or not model.Parent then
			if data.Destroy then data.Destroy() end
			return
		end
		data.Info.RootPart = getNPCRoot(model)
		
		if Settings.Highlight.Enabled then
			data.Items.Highlight.Adornee = model
		else
			data.Items.Highlight.Adornee = nil
		end
	end
	data.Destroy = function()
		for _, conn in ipairs(data.Connections) do
			if typeof(conn) == "RBXScriptConnection" and conn.Connected then conn:Disconnect() 
			elseif type(conn) == "table" and conn.Disconnect then conn:Disconnect() end
		end
		table.clear(data.Connections)
		if data.HealthTween then data.HealthTween:Cancel() end
		if items.Highlight then items.Highlight:Destroy() end
		if items.Holder then items.Holder:Destroy() end
		NPCData[model] = nil
	end
	local ancestryConn = model.AncestryChanged:Connect(function(_, parent)
		if not parent then
			if data.Destroy then data.Destroy() end
		end
	end)
	table.insert(data.Connections, ancestryConn)
	data.HealthConn = connectHealthChanged(model, function(health, maxHealth)
		data.UpdateHealth(health, maxHealth)
		if health <= 0 and not data.IsDead then
			data.StartDeathEffect()
		end
	end)
	if data.HealthConn then
		table.insert(data.Connections, data.HealthConn)
	end
	local initHealth, initMaxHealth = getNPCHealth(model)
	data.UpdateHealth(initHealth, initMaxHealth)
	if initHealth <= 0 then
		data.StartDeathEffect()
	end
	
	data.Refresh()
	NPCData[model] = data
end
local function ScanNPCs()
	if not Settings.NPC.Enabled then return end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and not isPlayerCharacter(obj) and hasHealthSystem(obj) then
			if not NPCData[obj] then
				CreateNPCData(obj)
			end
		end
	end
end
-- ========== UPDATE LOOP ==========
local function Update()
	if not Settings.Main.Enabled then
		for _, data in pairs(PlayerData) do
			if data.Items and data.Items.Holder then data.Items.Holder.Visible = false end
		end
		for _, data in pairs(NPCData) do
			if data.Items and data.Items.Holder then data.Items.Holder.Visible = false end
		end
		return
	end
	Camera = workspace.CurrentCamera
	local maxDistSq = Settings.Main.RenderDistance * Settings.Main.RenderDistance
	-- Players
	for player, data in pairs(PlayerData) do
		local info = data.Info
		local holder = data.Items and data.Items.Holder
		if not holder then continue end
		local rootPos = info.RootPart and info.RootPart.Position
		if not rootPos then
			if data.IsDead and data.FrozenRootPos then
				rootPos = data.FrozenRootPos
			else
				holder.Visible = false
				continue
			end
		end
		local distVec = rootPos - Camera.CFrame.Position
		local distSq = distVec:Dot(distVec)
		if distSq > maxDistSq then
			holder.Visible = false
			continue
		end
		local boxSize, boxPos, onScreen
		if data.IsDead then
			if Settings.Death.Enabled and data.FrozenTop and data.FrozenBottom then
				boxSize, boxPos, onScreen = CalculateBoxFromWorld(data.FrozenTop, data.FrozenBottom)
			else
				holder.Visible = false
				continue
			end
		else
			if not info.Character or not info.Humanoid or info.Humanoid.Health <= 0 then
				if info.Humanoid and info.Humanoid.Health <= 0 and not data.DeathStarted then
					data.StartDeathEffect()
				end
				holder.Visible = false
				continue
			end
			boxSize, boxPos, onScreen = CalculateBox(info.RootPart)
		end
		if onScreen then
			holder.Visible = true
			holder.Position = UDim2.fromOffset(boxPos.X, boxPos.Y)
			holder.Size = UDim2.fromOffset(boxSize.X, boxSize.Y)
			if not data.IsDead then
				local distance = math.sqrt(distSq)
				data.UpdateExtras(distance)
			end
		else
			holder.Visible = false
		end
	end
	-- NPCs
	if Settings.NPC.Enabled then
		for model, data in pairs(NPCData) do
			local holder = data.Items and data.Items.Holder
			if not holder then continue end
			if not model.Parent then
				data.Destroy()
				continue
			end
			local root = data.Info.RootPart
			if not root then
				holder.Visible = false
				continue
			end
			local rootPos = data.IsDead and data.FrozenRootPos or root.Position
			if not rootPos then
				holder.Visible = false
				continue
			end
			local distVec = rootPos - Camera.CFrame.Position
			local distSq = distVec:Dot(distVec)
			if distSq > maxDistSq then
				holder.Visible = false
				continue
			end
			local boxSize, boxPos, onScreen
			if data.IsDead then
				if Settings.Death.Enabled and data.FrozenTop and data.FrozenBottom then
					boxSize, boxPos, onScreen = CalculateBoxFromWorld(data.FrozenTop, data.FrozenBottom)
				else
					holder.Visible = false
					continue
				end
			else
				boxSize, boxPos, onScreen = CalculateBox(root)
			end
			if onScreen then
				holder.Visible = true
				holder.Position = UDim2.fromOffset(boxPos.X, boxPos.Y)
				holder.Size = UDim2.fromOffset(boxSize.X, boxSize.Y)
				if not data.IsDead then
					if data.Items.NameTag then
						data.Items.NameTag.Text = getCachedName(model)
					end
					if data.Items.DistanceTag then
						local distance = math.sqrt(distSq)
						data.Items.DistanceTag.Text = math.floor(distance + 0.5) .. Settings.Distance.Suffix
					end
				end
			else
				holder.Visible = false
			end
		end
	end
end
local function Initialize()
	for _, player in ipairs(Players:GetPlayers()) do
		if Settings.Main.IncludeLocalPlayer or player ~= LocalPlayer then
			CreatePlayerData(player)
		end
	end
	local added = Players.PlayerAdded:Connect(function(player)
		if Settings.Main.IncludeLocalPlayer or player ~= LocalPlayer then
			task.defer(function()
				CreatePlayerData(player)
			end)
		end
	end)
	table.insert(GlobalConnections, added)
	local removing = Players.PlayerRemoving:Connect(function(player)
		local data = PlayerData[player]
		if data and data.Destroy then data.Destroy() end
		FriendCache[player.UserId] = nil
	end)
	table.insert(GlobalConnections, removing)
	if Settings.NPC.Enabled then
		ScanNPCs()
		task.spawn(function()
			while ScreenGui and ScreenGui.Parent do
				ScanNPCs()
				task.wait(2)
			end
		end)
		local descConn = workspace.DescendantAdded:Connect(function(obj)
			if obj:IsA("Model") and Settings.NPC.Enabled then
				task.defer(function()
					if hasHealthSystem(obj) and not isPlayerCharacter(obj) then
						CreateNPCData(obj)
					end
				end)
			end
		end)
		table.insert(GlobalConnections, descConn)
	end
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, Update)
end
Initialize()
