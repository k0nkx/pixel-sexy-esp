local function CleanupAll()
	for _, conn in ipairs(GlobalConnections) do
		if typeof(conn) == "RBXScriptConnection" and conn.Connected then
			conn:Disconnect()
		elseif type(conn) == "table" and conn.Disconnect then
			conn:Disconnect()
		end
	end
	table.clear(GlobalConnections)
	for _, data in pairs(PlayerData) do
		if data.Destroy then data.Destroy() end
	end
	table.clear(PlayerData)
	for _, data in pairs(NPCData) do
		if data.Destroy then data.Destroy() end
	end
	table.clear(NPCData)
	pcall(function()
		RunService:UnbindFromRenderStep(RENDER_NAME)
	end)
	if ScreenGui then
		ScreenGui:Destroy()
	end
end
