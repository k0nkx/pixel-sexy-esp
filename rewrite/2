local function LoadCustomFont(Name, Link)
	local fn = Name:gsub("%s+", "")
	local ttf = fn .. ".ttf"
	local json = fn .. ".ttf.json"
	if not isfile(ttf) then
		local ok, data = pcall(function()
			return game:HttpGet(Link)
		end)
		if not ok or not data or #data == 0 then
			return nil
		end
		local wrote = pcall(function()
			writefile(ttf, data)
		end)
		if not wrote or not isfile(ttf) then
			return nil
		end
	end
	pcall(function()
		if isfile(json) then
			delfile(json)
		end
	end)
	local asset
	local okAsset = pcall(function()
		asset = getcustomasset(ttf)
	end)
	if not okAsset or not asset then
		return nil
	end
	local config = {
		name = fn,
		faces = {{
			name = "Regular",
			weight = 400,
			style = "normal",
			assetId = asset
		}}
	}
	local okWrite = pcall(function()
		writefile(json, HttpService:JSONEncode(config))
	end)
	if not okWrite or not isfile(json) then
		return nil
	end
	local okFont, font = pcall(function()
		return Font.new(getcustomasset(json), Enum.FontWeight.Regular)
	end)
	if okFont and font then
		return font
	end
	return nil
end
