                    if child:IsA("ImageLabel") then
                        local grad = child:FindFirstChild("UIGradient")
                        if grad then
                            grad.Color = ColorSequence.new(newColor)
                        end
                    end
                end
            end
        end)
        table.insert(EspLib._internal.EspConnections, teamConn)
    end
end

