local function Create(instance, options)
    local Ins = Instance.new(instance)
    for prop, value in pairs(options) do
        Ins[prop] = value
    end
    return Ins
end

function EspLib._internal.LoadCustomFont(fontName)
    local fontData = CustomFonts[fontName]
    if not fontData then return nil end
    
    local fileName = fontName .. ".ttf"
    local fontFileName = fontName .. ".font"
    
    local success, result = pcall(function()
        if not isfile(fileName) then
            return game:HttpGet(fontData.url)
        end
        return nil
    end)
    
    if success and result then
        local writeSuccess = pcall(function()
            writefile(fileName, result)
        end)
        if not writeSuccess then
            return nil
        end
    elseif not isfile(fileName) then
        return nil
    end
    
    local fontConfig = {
        name = fontName,
        faces = {{
            name = "Regular",
            weight = 400,
            style = "normal",
            assetId = getcustomasset(fileName)
        }}
    }
    
    local jsonSuccess = pcall(function()
        writefile(fontFileName, HttpService:JSONEncode(fontConfig))
    end)
    
    if not jsonSuccess then
        return nil
    end
    
    local fontSuccess, font = pcall(function()
        return Font.new(getcustomasset(fontFileName), Enum.FontWeight.Regular)
    end)
    
    if fontSuccess then
        return font
    end
    return nil
end

function EspLib._internal.ApplyFontToText(textLabel, settings)
    if settings.UseCustomFont then
        if not EspLib._internal.LoadedCustomFonts[settings.CustomFontName] then
            local font = EspLib._internal.LoadCustomFont(settings.CustomFontName)
            if font then
                EspLib._internal.LoadedCustomFonts[settings.CustomFontName] = font
                textLabel.FontFace = font
                return true
            else
                textLabel.Font = settings.Font
                return false
            end
        else
            textLabel.FontFace = EspLib._internal.LoadedCustomFonts[settings.CustomFontName]
            return true
        end
    else
        textLabel.Font = settings.Font
        return true
    end
end

