        self:_CreateVelocityTextElements(Items, player)
    end
    
    if settings.NameText.Enabled then
        self:_CreateNameTextElements(Items, player)
    end
    
    if settings.DistanceText.Enabled then
        self:_CreateDistanceTextElements(Items)
    end
    
    if settings.EquippedItemText.Enabled then
        self:_CreateEquippedItemTextElements(Items, player)
    end
    
    local HealthTween = nil
    
    Data.HealthChanged = function(Value)
        if settings.Healthbar.Enabled and Items.Healthbar then
            local Multiplier = math.clamp(Value / 100, 0, 1)
            local isHorizontal = settings.Healthbar.Position == "Top" or settings.Healthbar.Position == "Bottom"
            
            local targetSize
            local targetPosition
            
            if isHorizontal then
                local widthMult = 1 - Multiplier
                targetSize = dim2(widthMult, -2 * widthMult, 1, -2)
                targetPosition = dim2(Multiplier, 1, 0, 1)
            else
                local heightMult = 1 - Multiplier
                targetSize = dim2(1, -2, heightMult, -2 * heightMult)
                targetPosition = dim2(0, 1, 0, 1)
            end
            
            if settings.Healthbar.Tween and self.TweenService then
                if HealthTween and HealthTween.Cancel then
                    HealthTween:Cancel()
                end
                
                local tweenInfo = TweenInfo.new(
                    settings.Healthbar.TweenSpeed,
                    Enum.EasingStyle[settings.Healthbar.EasingStyle],
                    Enum.EasingDirection[settings.Healthbar.EasingDirection]
                )
                
                HealthTween = self.TweenService:Create(Items.HealthbarFade, tweenInfo, {
                    Size = targetSize,
                    Position = targetPosition
                })
                HealthTween:Play()
            else
                Items.HealthbarFade.Size = targetSize
                Items.HealthbarFade.Position = targetPosition
            end
        end
        
        if settings.HealthText.Enabled and Items.HealthText then
            Items.HealthText.Text = tostring(math.round(Value))
        end
    end
    
    Data.UpdateVelocity = function()
        if settings.VelocityText.Enabled and Items.VelocityText then
            local avgVel = self:_GetAverageVelocity(player)
            Items.VelocityText.Text = math.round(avgVel)
        end
    end
    
    Data.UpdateEquippedItem = function()
        if settings.EquippedItemText.Enabled and Items.EquippedItem then
            if self:_ShouldHideForTeam(player) then
                Items.EquippedItem.Text = ""
                return
            end
            
            local item = self:_GetEquippedItem(player)
            if item and item ~= "" then
                Items.EquippedItem.Text = item
            else
                Items.EquippedItem.Text = ""
            end
        end
    end
    
    Data.RefreshChams = function()
        if not settings.Chams.Enabled then
            if Data.Highlight then
                Data.Highlight:Destroy()
                Data.Highlight = nil
            end
            return
        end
        
        local Character = Data.Info.Character
        if Character then
            if not Data.Highlight then
                self:_CreateChamsElements(Data)
            else
                Data.Highlight.Adornee = Character
                Data.Highlight.Enabled = true
            end
        end
    end
    
    Data.RefreshDescendants = function()
        local Character = player.Character
        if not Character then
            Character = player.CharacterAdded:Wait()
        end
        local Humanoid = Character:FindFirstChild("Humanoid")
        if not Humanoid then
            Humanoid = Character:WaitForChild("Humanoid")
        end
        
        Data.Info.Character = Character
        Data.Info.Humanoid = Humanoid
        Data.Info.RootPart = Humanoid.RootPart
        
        if settings.Healthbar.Enabled or settings.HealthText.Enabled then
            local conn = Humanoid.HealthChanged:Connect(function(h)
                Data.HealthChanged(h)
            end)
            table.insert(self._connections, conn)
            Data.HealthChanged(Humanoid.Health)
        end
        
        if settings.EquippedItemText.Enabled then
            local attrConn = player:GetAttributeChangedSignal("EquippedItem"):Connect(function()
                Data.UpdateEquippedItem()
            end)
            table.insert(self._connections, attrConn)
            
            local teamConn = player:GetPropertyChangedSignal("Team"):Connect(function()
                Data.UpdateEquippedItem()
            end)
            table.insert(self._connections, teamConn)
            
            Data.UpdateEquippedItem()
        end
        
        Data.RefreshChams()
    end
    
    Data.Destroy = function()
        if Items.Holder then
            Items.Holder:Destroy()
        end
        if Data.Highlight then
            Data.Highlight:Destroy()
        end
        self._velocitySamples[player.Name] = nil
        self._espPlayers[player.Name] = nil
    end
    
    Data.RefreshDescendants()
    
    local conn = player.CharacterAdded:Connect(function()
        Data.RefreshDescendants()
    end)
    table.insert(self._connections, conn)
    
    self._espPlayers[player.Name] = Data
end

function EspLibrary:_Update()
    if not self._loaded then return end
    
    local settings = self._settings
    
    if not settings.Main.Enabled then
        for _, Data in pairs(self._espPlayers) do
            if Data.Items and Data.Items.Holder then
                Data.Items.Holder.Visible = false
            end
            -- Disable chams when main is disabled
            if Data.Highlight then
                Data.Highlight.Enabled = false
            end
        end
        return
    end
    
    local hasAnyFeature = settings.Box.Enabled or settings.NameText.Enabled or settings.DistanceText.Enabled or settings.Healthbar.Enabled or settings.HealthText.Enabled or settings.VelocityText.Enabled or settings.EquippedItemText.Enabled
    
    if not hasAnyFeature then
        for _, Data in pairs(self._espPlayers) do
            if Data.Items and Data.Items.Holder then
                Data.Items.Holder.Visible = false
            end
        end
        return
    end
    
    -- Update chams state for all players
    for _, Data in pairs(self._espPlayers) do
        if Data.Highlight then
            Data.Highlight.Enabled = settings.Chams.Enabled
        end
    end
    
    if settings.VelocityText.Enabled then
        for _, Data in pairs(self._espPlayers) do
            if Data.UpdateVelocity then
                Data.UpdateVelocity()
            end
        end
    end
    
    if settings.EquippedItemText.Enabled then
        for _, Data in pairs(self._espPlayers) do
            if Data.UpdateEquippedItem then
                Data.UpdateEquippedItem()
            end
        end
    end
    
    local needsPositionCalc = settings.Box.Enabled or settings.DistanceText.Enabled
    
    for _, Data in pairs(self._espPlayers) do
        if Data.Info and Data.Info.Character and Data.Info.Humanoid and Data.Info.Humanoid.RootPart then
            local Items = Data.Items
            local Holder = Items.Holder
            
            if Holder then
                if needsPositionCalc then
                    local BoxSize, BoxPos, OnScreen, Distance = self:_BoxSolve(Data.Info.Humanoid.RootPart)
                    
                    if Distance and Distance <= settings.Main.RenderDistance and OnScreen then
                        Holder.Visible = true
                        Holder.Position = dim_offset(BoxPos.X, BoxPos.Y)
                        Holder.Size = dim2(0, BoxSize.X, 0, BoxSize.Y)
                        
                        if settings.DistanceText.Enabled and Items.Distance then
                            Items.Distance.Text = tostring(math.round(Distance)) .. "m"
                        end
                    else
                        Holder.Visible = false
                    end
                else
                    Holder.Visible = true
                end
            end
        end
    end
end

function EspLibrary:_Initialize()
    self:_UpdateSettings()
    
    for _, player in pairs(self.PlayersService:GetPlayers()) do
        if self._settings.Main.IncludeLocalPlayer then
            self:_CreateObject(player)
        else
            if player ~= self.PlayersService.LocalPlayer then
                self:_CreateObject(player)
            end
        end
    end
    
    local playerAddedConn = self.PlayersService.PlayerAdded:Connect(function(player)
        if self._settings.Main.IncludeLocalPlayer then
            self:_CreateObject(player)
        else
            if player ~= self.PlayersService.LocalPlayer then
                self:_CreateObject(player)
            end
        end
    end)
    table.insert(self._connections, playerAddedConn)
    
    local playerRemovingConn = self.PlayersService.PlayerRemoving:Connect(function(player)
        if self._espPlayers[player.Name] then
            self._espPlayers[player.Name]:Destroy()
        end
    end)
    table.insert(self._connections, playerRemovingConn)
    
    self._loopConnection = self.RunService:BindToRenderStep("Run Loop", Enum.RenderPriority.Camera.Value + 1, function()
        self:_Update()
    end)
end

return EspLibrary
