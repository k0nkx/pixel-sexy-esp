    end
    
    return label
end

function EspLib._internal.ConvertScreenPoint(world_position)
    local ViewportSize = Camera.ViewportSize
    local LocalPos = Camera.CFrame:PointToObjectSpace(world_position)
    
    local AspectRatio = ViewportSize.X / ViewportSize.Y
    local HalfY = -LocalPos.Z * math.tan(math.rad(Camera.FieldOfView / 2))
    local HalfX = AspectRatio * HalfY
    
    local FarPlaneCorner = Vector3.new(-HalfX, HalfY, LocalPos.Z)
    local RelativePos = LocalPos - FarPlaneCorner
    
    local ScreenX = RelativePos.X / (HalfX * 2)
    local ScreenY = -RelativePos.Y / (HalfY * 2)
    
    local OnScreen = -LocalPos.Z > 0 and ScreenX >= 0 and ScreenX <= 1 and ScreenY >= 0 and ScreenY <= 1
    
    return Vector3.new(ScreenX * ViewportSize.X, ScreenY * ViewportSize.Y, -LocalPos.Z), OnScreen
end

function EspLib._internal.BoxSolve(rootPart)
    if not rootPart then
        return nil, nil, nil, nil
    end
    
    local ViewportTop = rootPart.Position + (rootPart.CFrame.UpVector * 1.8) + Camera.CFrame.UpVector
    local ViewportBottom = rootPart.Position - (rootPart.CFrame.UpVector * 2.5) - Camera.CFrame.UpVector
    local Distance = (rootPart.Position - Camera.CFrame.Position).Magnitude
    
    local Top, TopIsRendered = EspLib._internal.ConvertScreenPoint(ViewportTop)
    local Bottom, BottomIsRendered = EspLib._internal.ConvertScreenPoint(ViewportBottom)
    
    local Width = math.max(math.floor(math.abs(Top.X - Bottom.X)), 8)
    local Height = math.max(math.floor(math.max(math.abs(Bottom.Y - Top.Y), Width / 2)), 12)
    local BoxSize = Vector2.new(math.floor(math.max(Height / 1.5, Width)), Height)
    local BoxPosition = Vector2.new(math.floor(Top.X * 0.5 + Bottom.X * 0.5 - BoxSize.X * 0.5), math.floor(math.min(Top.Y, Bottom.Y)))
    
    return BoxSize, BoxPosition, TopIsRendered, Distance
end

function EspLib._internal.GetTeamColor(player)
    if not EspLib.Settings.Main.UseTeamColor then
        return nil
    end
    
    local team = player.Team
    if team and team.TeamColor then
        return team.TeamColor.Color
    end
    return nil
end

function EspLib._internal.GetVelocity(player)
    if not player or not player.Character then
        return 0
    end
    
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return 0
    end
    
    local velocity = rootPart.AssemblyLinearVelocity
    if not velocity then
        return 0
    end
    
    return velocity.Magnitude
end

function EspLib._internal.GetAverageVelocity(player)
    if not EspLib._internal.VelocitySamples[player.Name] then
        EspLib._internal.VelocitySamples[player.Name] = {}
    end
    
    local samples = EspLib._internal.VelocitySamples[player.Name]
    local currentVel = EspLib._internal.GetVelocity(player)
    
    table.insert(samples, currentVel)
    
    local maxSamples = EspLib.Settings.VelocityText.AverageSamples or 10
    if #samples > maxSamples then
        table.remove(samples, 1)
    end
    
    local sum = 0
    for _, v in pairs(samples) do
        sum = sum + v
    end
    
    return sum / #samples
end

function EspLib._internal.GetEquippedItem(player)
    if not player then
        return nil
    end
    
    return player:GetAttribute("EquippedItem")
end

function EspLib._internal.ShouldHideForTeam(player)
    if not EspLib.Settings.EquippedItemText.HideForTeamKiller then
        return false
    end
    
    local team = player.Team
    if team and team.Name == EspLib.Settings.EquippedItemText.KillerTeamName then
        return true
    end
    return false
end

