        Size = dim2(1, 0, 0, 0),
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.XY,
        TextSize = textSettings.Size,
        BackgroundColor3 = rgb(255, 255, 255),
        ZIndex = 2
    })
    
    self:_ApplyFontToText(label, textSettings)
    
    local stroke = Create("UIStroke", {
        Parent = label,
        LineJoinMode = Enum.LineJoinMode.Miter,
        ZIndex = 1
    })
    
