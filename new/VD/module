end

function EspLibrary:Load()
    if self._loaded then
        self:Unload()
        wait(0.1)
    end
    
    self._loaded = true
    
    -- Setup services
    self.PlayersService = cloneref(game:GetService("Players"))
    self.RunService = cloneref(game:GetService("RunService"))
    self.Camera = cloneref(workspace.CurrentCamera)
    self.TweenService = cloneref(game:GetService("TweenService"))
    self.CoreGui = cloneref(game:GetService("CoreGui"))
    self.HttpService = cloneref(game:GetService("HttpService"))
    
    -- Create GUIs
    self.ScreenGui = Instance.new("ScreenGui")
    self.ScreenGui.Name = "EspObject"
    self.ScreenGui.IgnoreGuiInset = true
    self.ScreenGui.ResetOnSpawn = false
    self.ScreenGui.Parent = self.CoreGui
    
    self.Cache = Instance.new("ScreenGui")
    self.Cache.Name = "EspCache"
    self.Cache.Enabled = false
    self.Cache.ResetOnSpawn = false
    self.Cache.Parent = self.CoreGui
    
    -- Initialize
    self:_Initialize()
    
    return self
end

function EspLibrary:Unload()
    if not self._loaded then return end
    
    for _, conn in pairs(self._connections) do
        conn:Disconnect()
    end
    self._connections = {}
    
    if self._loopConnection then
        self.RunService:UnbindFromRenderStep("Run Loop")
        self._loopConnection = nil
    end
    
    for _, data in pairs(self._espPlayers) do
        if data.Destroy then
            data:Destroy()
        end
    end
    self._espPlayers = {}
    
    if self.ScreenGui then
        self.ScreenGui:Destroy()
        self.ScreenGui = nil
    end
    if self.Cache then
        self.Cache:Destroy()
        self.Cache = nil
    end
    
    self._loaded = false
end

