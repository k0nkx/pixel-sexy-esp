-- Helper functions
local function rgb(r, g, b)
    return Color3.fromRGB(r, g, b)
end

local function dim2(xScale, xOffset, yScale, yOffset)
    return UDim2.new(xScale, xOffset, yScale, yOffset)
end

local function dim(scale, offset)
    return UDim.new(scale, offset)
end

local function dim_offset(x, y)
    return UDim2.new(0, x, 0, y)
end

local function vec2(x, y)
    return Vector2.new(x, y)
end

local function rect(min, max)
    return Rect.new(min, max)
end

local function Create(instance, options)
    local Ins = Instance.new(instance)
    for prop, value in pairs(options) do
        Ins[prop] = value
    end
    return Ins
end

-- Main library functions
function ESPLib:GetSettings()
    return CurrentSettings
end

function ESPLib:UpdateSettings(newSettings)
    if not newSettings then return end
    
    local function deepMerge(target, source)
        for key, value in pairs(source) do
            if type(value) == "table" and type(target[key]) == "table" then
                deepMerge(target[key], value)
            else
                target[key] = value
            end
        end
    end
    
    local settingsCopy = {}
    for key, value in pairs(DefaultSettings) do
        settingsCopy[key] = value
    end
    
    deepMerge(settingsCopy, newSettings)
    CurrentSettings = settingsCopy
    
    if IsRunning then
        ESPLib:Stop()
        task.wait(0.1)
        ESPLib:Start()
    end
end

function ESPLib:Start()
    if IsRunning then
        ESPLib:Stop()
    end
    
    IsRunning = true
    ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "EspObject"
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = CoreGui
    
    Cache = Instance.new("ScreenGui")
    Cache.Name = "EspCache"
    Cache.Enabled = false
    Cache.ResetOnSpawn = false
    Cache.Parent = CoreGui
    
    Initialize()
end

function ESPLib:Stop()
    IsRunning = false
    Unload()
end

