    end
    
    if EspLib.Settings.HealthText.Enabled then
        EspLib._internal.CreateHealthTextElements(Items, player)
    end
    
    if EspLib.Settings.VelocityText.Enabled then
        EspLib._internal.CreateVelocityTextElements(Items, player)
    end
    
    if EspLib.Settings.NameText.Enabled then
        EspLib._internal.CreateNameTextElements(Items, player)
    end
    
    if EspLib.Settings.DistanceText.Enabled then
        EspLib._internal.CreateDistanceTextElements(Items)
    end
    
    if EspLib.Settings.EquippedItemText.Enabled then
        EspLib._internal.CreateEquippedItemTextElements(Items, player)
    end
    
    local HealthTween = nil
    
    Data.HealthChanged = function(Value)
        if EspLib.Settings.Healthbar.Enabled and Items.Healthbar then
            local Multiplier = math.clamp(Value / 100, 0, 1)
            local isHorizontal = EspLib.Settings.Healthbar.Position == "Top" or EspLib.Settings.Healthbar.Position == "Bottom"
            
            local targetSize
            local targetPosition
            
            if isHorizontal then
                local widthMult = 1 - Multiplier
                targetSize = dim2(widthMult, -2 * widthMult, 1, -2)
                targetPosition = dim2(Multiplier, 1, 0, 1)
            else
                local heightMult = 1 - Multiplier
                targetSize = dim2(1, -2, heightMult, -2 * heightMult)
                targetPosition = dim2(0, 1, 0, 1)
            end
            
            if EspLib.Settings.Healthbar.Tween and TweenService then
                if HealthTween and HealthTween.Cancel then
                    HealthTween:Cancel()
                end
                
                local tweenInfo = TweenInfo.new(
                    EspLib.Settings.Healthbar.TweenSpeed,
                    Enum.EasingStyle[EspLib.Settings.Healthbar.EasingStyle],
                    Enum.EasingDirection[EspLib.Settings.Healthbar.EasingDirection]
                )
                
                HealthTween = TweenService:Create(Items.HealthbarFade, tweenInfo, {
                    Size = targetSize,
                    Position = targetPosition
                })
                HealthTween:Play()
            else
                Items.HealthbarFade.Size = targetSize
                Items.HealthbarFade.Position = targetPosition
            end
        end
        
        if EspLib.Settings.HealthText.Enabled and Items.HealthText then
            Items.HealthText.Text = tostring(math.round(Value))
        end
    end
    
    Data.UpdateVelocity = function()
        if EspLib.Settings.VelocityText.Enabled and Items.VelocityText then
            local avgVel = EspLib._internal.GetAverageVelocity(player)
            Items.VelocityText.Text = math.round(avgVel)
        end
    end
    
    Data.UpdateEquippedItem = function()
        if EspLib.Settings.EquippedItemText.Enabled and Items.EquippedItem then
            if EspLib._internal.ShouldHideForTeam(player) then
                Items.EquippedItem.Text = ""
                return
            end
            
            local item = EspLib._internal.GetEquippedItem(player)
            if item and item ~= "" then
                Items.EquippedItem.Text = item
            else
                Items.EquippedItem.Text = ""
            end
        end
    end
    
    Data.RefreshChams = function()
        if EspLib.Settings.Chams.Enabled and EspLib.Settings.Main.Enabled then
            local Character = Data.Info.Character
            if Character then
                if not Data.Highlight then
                    EspLib._internal.CreateChamsElements(Data)
                else
                    Data.Highlight.Adornee = Character
                    Data.Highlight.Enabled = true
                end
            end
        else
            if Data.Highlight then
                Data.Highlight:Destroy()
                Data.Highlight = nil
            end
        end
    end
    
    Data.RefreshDescendants = function()
        local Character = player.Character
        if not Character then
            Character = player.CharacterAdded:Wait()
        end
        local Humanoid = Character:FindFirstChild("Humanoid")
        if not Humanoid then
            Humanoid = Character:WaitForChild("Humanoid")
        end
        
        Data.Info.Character = Character
        Data.Info.Humanoid = Humanoid
        Data.Info.RootPart = Humanoid.RootPart
        
        if EspLib.Settings.Healthbar.Enabled or EspLib.Settings.HealthText.Enabled then
            local conn = Humanoid.HealthChanged:Connect(function(h)
                Data.HealthChanged(h)
            end)
            table.insert(EspLib._internal.EspConnections, conn)
            Data.HealthChanged(Humanoid.Health)
        end
        
        if EspLib.Settings.EquippedItemText.Enabled then
            local attrConn = player:GetAttributeChangedSignal("EquippedItem"):Connect(function()
                Data.UpdateEquippedItem()
            end)
            table.insert(EspLib._internal.EspConnections, attrConn)
            
            local teamConn = player:GetPropertyChangedSignal("Team"):Connect(function()
                Data.UpdateEquippedItem()
            end)
            table.insert(EspLib._internal.EspConnections, teamConn)
            
            Data.UpdateEquippedItem()
        end
        
        Data.RefreshChams()
    end
    
    Data.Destroy = function()
        if Items.Holder then
            Items.Holder:Destroy()
        end
        if Data.Highlight then
            Data.Highlight:Destroy()
        end
        EspLib._internal.VelocitySamples[player.Name] = nil
        EspLib._internal.EspPlayers[player.Name] = nil
    end
    
    Data.RefreshDescendants()
    
    local conn = player.CharacterAdded:Connect(function()
        Data.RefreshDescendants()
    end)
    table.insert(EspLib._internal.EspConnections, conn)
    
    EspLib._internal.EspPlayers[player.Name] = Data
end

function EspLib._internal.Update()
    if not EspLib.Settings.Main.Enabled then
        for _, Data in pairs(EspLib._internal.EspPlayers) do
            if Data.Items and Data.Items.Holder then
                Data.Items.Holder.Visible = false
            end
            if Data.RefreshChams then
                Data:RefreshChams()
            end
        end
        return
    end
    
    local hasAnyFeature = EspLib.Settings.Box.Enabled or EspLib.Settings.NameText.Enabled or EspLib.Settings.DistanceText.Enabled or EspLib.Settings.Healthbar.Enabled or EspLib.Settings.HealthText.Enabled or EspLib.Settings.VelocityText.Enabled or EspLib.Settings.EquippedItemText.Enabled
    
    if not hasAnyFeature then
        for _, Data in pairs(EspLib._internal.EspPlayers) do
            if Data.Items and Data.Items.Holder then
                Data.Items.Holder.Visible = false
            end
        end
        return
    end
    
    if EspLib.Settings.VelocityText.Enabled then
        for _, Data in pairs(EspLib._internal.EspPlayers) do
            if Data.UpdateVelocity then
                Data.UpdateVelocity()
            end
        end
    end
    
    if EspLib.Settings.EquippedItemText.Enabled then
        for _, Data in pairs(EspLib._internal.EspPlayers) do
            if Data.UpdateEquippedItem then
                Data.UpdateEquippedItem()
            end
        end
    end
    
    local needsPositionCalc = EspLib.Settings.Box.Enabled or EspLib.Settings.DistanceText.Enabled
    
    for _, Data in pairs(EspLib._internal.EspPlayers) do
        if Data.Info and Data.Info.Character and Data.Info.Humanoid and Data.Info.Humanoid.RootPart then
            local Items = Data.Items
            local Holder = Items.Holder
            
            if Holder then
                if needsPositionCalc then
                    local BoxSize, BoxPos, OnScreen, Distance = EspLib._internal.BoxSolve(Data.Info.Humanoid.RootPart)
                    
                    if Distance and Distance <= EspLib.Settings.Main.RenderDistance and OnScreen then
                        Holder.Visible = true
                        Holder.Position = dim_offset(BoxPos.X, BoxPos.Y)
                        Holder.Size = dim2(0, BoxSize.X, 0, BoxSize.Y)
                        
                        if EspLib.Settings.DistanceText.Enabled and Items.Distance then
                            Items.Distance.Text = tostring(math.round(Distance)) .. "m"
                        end
                    else
                        Holder.Visible = false
                    end
                else
                    Holder.Visible = true
                end
            end
        end
    end
    
    -- Refresh chams for all players
    for _, Data in pairs(EspLib._internal.EspPlayers) do
        if Data.RefreshChams then
            Data:RefreshChams()
        end
    end
end

-- Public API
function EspLib:Initialize()
    if self._internal.Initialized then
        return
    end
    
    local Players = cloneref(game:GetService("Players"))
    local RunService = cloneref(game:GetService("RunService"))
    local Camera = cloneref(workspace.CurrentCamera)
    local TweenService = cloneref(game:GetService("TweenService"))
    local CoreGui = cloneref(game:GetService("CoreGui"))
    local HttpService = cloneref(game:GetService("HttpService"))
    
    self._internal.ScreenGui = Instance.new("ScreenGui")
    self._internal.ScreenGui.Name = "EspObject"
    self._internal.ScreenGui.IgnoreGuiInset = true
    self._internal.ScreenGui.ResetOnSpawn = false
    self._internal.ScreenGui.Parent = CoreGui
    
    self._internal.Cache = Instance.new("ScreenGui")
    self._internal.Cache.Name = "EspCache"
    self._internal.Cache.Enabled = false
    self._internal.Cache.ResetOnSpawn = false
    self._internal.Cache.Parent = CoreGui
    
    for _, player in pairs(Players:GetPlayers()) do
        if self.Settings.Main.IncludeLocalPlayer then
            self._internal.CreateObject(player)
        else
            if player ~= Players.LocalPlayer then
                self._internal.CreateObject(player)
            end
        end
    end

    local playerAddedConn = Players.PlayerAdded:Connect(function(player)
        if self.Settings.Main.IncludeLocalPlayer then
            self._internal.CreateObject(player)
        else
            if player ~= Players.LocalPlayer then
                self._internal.CreateObject(player)
            end
        end
    end)
    table.insert(self._internal.EspConnections, playerAddedConn)

    local playerRemovingConn = Players.PlayerRemoving:Connect(function(player)
        if self._internal.EspPlayers[player.Name] then
            self._internal.EspPlayers[player.Name].Destroy()
        end
    end)
    table.insert(self._internal.EspConnections, playerRemovingConn)

    self._internal.LoopConnection = RunService:BindToRenderStep("Run Loop", Enum.RenderPriority.Camera.Value + 1, function()
        self._internal.Update()
    end)
    
    self._internal.Initialized = true
end

function EspLib:Unload()
    for _, conn in pairs(self._internal.EspConnections) do
        conn:Disconnect()
    end
    if self._internal.LoopConnection then
        local RunService = cloneref(game:GetService("RunService"))
        RunService:UnbindFromRenderStep("Run Loop")
        self._internal.LoopConnection = nil
    end
    for _, data in pairs(self._internal.EspPlayers) do
        if data.Destroy then
            data.Destroy()
        end
    end
    if self._internal.ScreenGui then
        self._internal.ScreenGui:Destroy()
    end
    if self._internal.Cache then
        self._internal.Cache:Destroy()
    end
    self._internal.Initialized = false
end

function EspLib:UpdateSettings(newSettings)
    for category, settings in pairs(newSettings) do
        if self.Settings[category] then
            for key, value in pairs(settings) do
                if type(value) == "table" and type(self.Settings[category][key]) == "table" then
                    for subKey, subValue in pairs(value) do
                        self.Settings[category][key][subKey] = subValue
                    end
                else
                    self.Settings[category][key] = value
                end
            end
        end
    end
end

-- Return the library
return EspLib
