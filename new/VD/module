-- Initialize function (from original)
local function Initialize()
    for _, player in pairs(Players:GetPlayers()) do
        if CurrentSettings.Main.IncludeLocalPlayer then
            CreateObject(player)
        else
            if player ~= Players.LocalPlayer then
                CreateObject(player)
            end
        }
    end

    local playerAddedConn = Players.PlayerAdded:Connect(function(player)
        if CurrentSettings.Main.IncludeLocalPlayer then
            CreateObject(player)
        else
            if player ~= Players.LocalPlayer then
                CreateObject(player)
            end
        end
    end)
    table.insert(EspConnections, playerAddedConn)

    local playerRemovingConn = Players.PlayerRemoving:Connect(function(player)
        if EspPlayers[player.Name] then
            EspPlayers[player.Name].Destroy()
        end
    end)
    table.insert(EspConnections, playerRemovingConn)

    LoopConnection = RunService:BindToRenderStep("Run Loop", Enum.RenderPriority.Camera.Value + 1, Update)
end

-- Unload function (from original)
local function Unload()
    for _, conn in pairs(EspConnections) do
        conn:Disconnect()
    end
    if LoopConnection then
        RunService:UnbindFromRenderStep("Run Loop")
        LoopConnection = nil
    end
    for _, data in pairs(EspPlayers) do
        if data.Destroy then
            data.Destroy()
        end
    end
    if ScreenGui then
        ScreenGui:Destroy()
    end
    if Cache then
        Cache:Destroy()
    end
end

